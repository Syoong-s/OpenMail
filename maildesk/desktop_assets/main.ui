                                    <property name="label">所有邮件</property>
                                    <style>
                                      <class name="nav" />
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="nav_new_senders">
                                    <property name="name">nav_new_senders</property>
                                    <property name="label">新发件人</property>
                                    <style>
                                      <class name="nav" />
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="nav_blocked">
                                    <property name="name">nav_blocked</property>
                                    <property name="label">已屏蔽</property>
                                    <style>
                                      <class name="nav" />
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="import">
                                <property name="name">import</property>
                                <property name="label">导入 EML</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="open_document">
                                <property name="name">open_document</property>
                                <property name="label">打开文件…</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                      </packing>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkRevealer" id="toast_revealer">
            <property name="name">toast_revealer</property>
            <property name="reveal-child">False</property>
            <property name="transition-type">slide-up</property>
            <property name="transition-duration">220</property>
            <child>
              <object class="GtkBox" id="toast">
                <property name="name">toast</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">16</property>
                <property name="margin">12</property>
                <child>
                  <object class="GtkLabel" id="status">
                    <property name="name">status</property>
                    <property name="label">就绪</property>
                    <property name="xalign">0</property>
                    <property name="wrap">True</property>
                    <property name="hexpand">True</property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="toast_close">
                    <property name="name">toast_close</property>
                    <property name="label">关闭</property>
                    <style>
                      <class name="quiet" />
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkButton" id="contacts">
    <property name="name">contacts</property>
    <property name="label">◎</property>
    <property name="tooltip-text">通讯录</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
    <style>
      <class name="rail-button" />
    </style>
  </object>
  <object class="GtkButton" id="settings">
    <property name="name">settings</property>
    <property name="label">●</property>
    <property name="tooltip-text">账号</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
    <style>
      <class name="rail-button" />
    </style>
  </object>
  <object class="GtkLabel" id="avatar">
    <property name="name">avatar</property>
    <property name="label">我</property>
    <property name="xalign">0.5</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
    <style>
      <class name="avatar" />
    </style>
  </object>
  <object class="GtkButton" id="demo">
    <property name="name">demo</property>
    <property name="label">演示邮箱</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
  </object>
  <object class="GtkButton" id="install">
    <property name="name">install</property>
    <property name="label">安装应用</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
  </object>
  <object class="GtkButton" id="view_add">
    <property name="name">view_add</property>
    <property name="label">＋ 增加收件箱视图</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
    <style>
      <class name="popover-action" />
    </style>
  </object>
  <object class="GtkButton" id="folders_manage">
    <property name="name">folders_manage</property>
    <property name="label">＋</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
    <style>
      <class name="small-icon" />
    </style>
  </object>
  <object class="GtkComboBoxText" id="category_filter">
    <property name="name">category_filter</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
    <items>
      <item id="all">全部</item>
      <item id="personal">个人</item>
      <item id="verification">验证码</item>
                  <item id="notification">通知</item>
      <item id="newsletter">订阅</item>
    </items>
  </object>
  <object class="GtkComboBoxText" id="inbox_mode">
    <property name="name">inbox_mode</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
    <items />
  </object>
  <object class="GtkButton" id="rail_pinned">
    <property name="name">rail_pinned</property>
    <property name="label">♧</property>
    <property name="tooltip-text">已置顶</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
  </object>
  <object class="GtkButton" id="rail_sent">
    <property name="name">rail_sent</property>
    <property name="label">➤</property>
    <property name="tooltip-text">已发送</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
  </object>
  <object class="GtkButton" id="rail_trash">
    <property name="name">rail_trash</property>
    <property name="label">♜</property>
    <property name="tooltip-text">废纸篓</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
  </object>
  <object class="GtkButton" id="rail_done">
    <property name="name">rail_done</property>
    <property name="label">✓</property>
    <property name="tooltip-text">已完成</property>
    <property name="no-show-all">True</property>
    <property name="visible">False</property>
  </object>
  <object class="GtkButton" id="rail_inbox">
    <property name="name">rail_inbox</property>
    <property name="label">▣</property>
    <property name="tooltip-text">收件箱</property>
    <style>
      <class name="rail-active" />
    </style>
  </object>
  <object class="GtkToggleButton" id="folder_toggle">
    <property name="name">folder_toggle</property>
    <property name="label">▱</property>
    <property name="tooltip-text">文件夹与邮箱</property>
  </object>
  <object class="GtkToggleButton" id="navigation_toggle">
    <property name="name">navigation_toggle</property>
    <property name="label">☰</property>
    <property name="tooltip-text">更多邮箱</property>
  </object>
  <object class="GtkButton" id="preferences">
    <property name="name">preferences</property>
    <property name="label">⚙</property>
    <property name="tooltip-text">设置</property>
    <style>
      <class name="rail-button" />
    </style>
  </object>
</interface>
